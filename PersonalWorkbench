function route(){const [page,id]=location.hash.slice(1).split('/');view=['overview','research','learning','education','tasks','settings'].includes(page)?page:'overview';selected=id||null;search='';$('#search').value='';statusFilter='active';if(hideFamily&&view==='education'){view='overview';selected=null;}render();window.scrollTo(0,0);}
function render(){
