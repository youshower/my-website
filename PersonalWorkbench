<script>
'use strict';
const $ = (selector) => document.querySelector(selector);
const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const paths = {
  home:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  research:'<path d="M9 3h6m-5 0v7l-5 8a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-8V3M8 15h8"/><path d="M10 18h.01m3-1h.01"/>',
  learning:'<path d="M12 5v16M3 4c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2Z"/>',
  education:'<path d="M12 21V10m0 6C5 17 2 12 3 7c6-1 10 3 9 9Zm0-3c-1-6 3-10 9-9 1 6-3 10-9 9Z"/>',
  task:'<rect x="4" y="3" width="16" height="18" rx="3"/><path d="m8 12 3 3 5-6"/>',
  file:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8m-8 4h5"/>',
  settings:'<path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3"/><circle cx="15" cy="17" r="3"/>',
  ai:'<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5ZM20 3v4m-2-2h4"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
};
const icon = name => `<svg viewBox="0 0 24 24" aria-hidden="true">${paths[name] || paths.file}</svg>`;
const names = {project:'科研项目',learning:'学习条目',exam:'考试复盘',mistake:'代表错题',research:'科研',education:'家庭教育',overview:'总览',tasks:'全部任务',settings:'数据与备份'};
const modules = {project:'research',learning:'learning',exam:'education',mistake:'education'};
const moduleNames = {research:'科研',learning:'学习',education:'家庭教育'};
const statusNames = {active:'进行中',done:'已完成',archived:'已归档',todo:'待开始',doing:'进行中'};
const jobNames = {ready:'待交接',working:'处理中（人工）',review:'待审核',revision:'退回修改',approved:'已批准',archived:'已归档',cancelled:'已取消'};
const resultNames = {independent:'独立做对',hint:'提示后做对',incorrect:'仍有困难'};
let state, view='overview', selected=null, search='', eduTab='exam', statusFilter='active', subjectFilter='', hideFamily=(()=>{try{return localStorage.getItem('workbench-hide-family')==='1';}catch{return false;}})(), uploadTarget=null, busy=false;
const entityById = id => state.entities.find(e=>e.id===id);
const today = () => {const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
const afterDays = n => {const d=new Date();d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
const size = n => n<1024?`${n} B`:n<1048576?`${(n/1024).toFixed(1)} KB`:`${(n/1048576).toFixed(1)} MB`;
const visibleEntity = e => !(hideFamily && modules[e.kind]==='education');
const visibleTask = t => !(hideFamily && t.module==='education');
const matches = e => !search || JSON.stringify(e).toLowerCase().includes(search.toLowerCase());
const labelStatus = status => `<span class="tag ${status==='archived'?'gray':status==='done'?'blue':''}">${statusNames[status]||esc(status)}</span>`;
const moduleTag = module => `<span class="tag ${module==='learning'?'gold':module==='education'?'blue':''}">${moduleNames[module]}</span>`;
const formatTime = s => new Date(s).toLocaleString('zh-CN',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});

const STORAGE_KEY = 'zhixing-workbench-html-v1';
function freshStore() {return {schema:1,entities:[],tasks:[],reviews:[]};}
function readStore() {
  let raw;
  try {raw=localStorage.getItem(STORAGE_KEY);} catch {throw new Error('当前浏览器不允许保存数据。请用普通浏览模式，或将 HTML 放到您自己的静态网站中访问。');}
  if(!raw)return freshStore();
  try {return validateStore(JSON.parse(raw));} catch {throw new Error('浏览器中的记录格式异常，未覆盖原数据。请保留数据并从备份恢复。');}
}
function saveStore(store) {
  validateStore(store);
  try {localStorage.setItem(STORAGE_KEY,JSON.stringify(store));} catch {throw new Error('保存失败：浏览器存储已满或被禁用。请先导出记录，不要关闭尚未保存的表单。');}
}
function validateStore(store) {
  const fail=()=>{throw new Error('备份格式或记录关联不正确，当前数据保持不变。');};
  const dateOK=v=>v==null||v===''||typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(v)&&!Number.isNaN(Date.parse(v));
  const textOK=v=>typeof v==='string'&&v.length<=30000;
  const idOK=v=>typeof v==='string'&&/^[a-f0-9]{32}$/.test(v);
  if(!store||store.schema!==1||!Array.isArray(store.entities)||!Array.isArray(store.tasks)||!Array.isArray(store.reviews))fail();
  if(store.entities.length+store.tasks.length+store.reviews.length>20000)fail();
  const ids=new Map();
  for(const e of store.entities){
    if(!e||!idOK(e.id)||ids.has(e.id)||!['project','learning','exam','mistake'].includes(e.kind)||!textOK(e.title)||!e.title.trim()||!['active','done','archived'].includes(e.status)||!e.details||typeof e.details!=='object'||Array.isArray(e.details)||!textOK(e.created)||!textOK(e.updated))fail();
    for(const [key,value] of Object.entries(e.details)){
      if(['score','full_score'].includes(key)){if(value!==null&&(typeof value!=='number'||!Number.isFinite(value)||value<0||value>10000))fail();}
      else if(['due','exam_date','next_review'].includes(key)){if(!dateOK(value))fail();}
      else if(key==='project_id'){if(value!=null&&!idOK(value))fail();}
      else if(!textOK(value))fail();
    }
    if(e.kind==='exam'&&(!dateOK(e.details.exam_date)||!e.details.exam_date||!(e.details.full_score>0)||(e.details.score!=null&&e.details.score>e.details.full_score)))fail();
    if(['exam','mistake'].includes(e.kind)&&!textOK(e.details.subject))fail();
    ids.set(e.id,e);
  }
  for(const e of store.entities){
    if(e.parent_id&&(e.kind!=='mistake'||ids.get(e.parent_id)?.kind!=='exam'))fail();
    if(e.details.project_id&&(e.kind!=='learning'||ids.get(e.details.project_id)?.kind!=='project'))fail();
  }
  const tids=new Set();
  for(const t of store.tasks){
    if(!t||!idOK(t.id)||tids.has(t.id)||!textOK(t.title)||!t.title.trim()||!['research','learning','education'].includes(t.module)||!['todo','doing','done'].includes(t.status)||!['normal','high'].includes(t.priority)||!dateOK(t.due)||!textOK(t.notes)||!textOK(t.created))fail();
    if(t.entity_id&&modules[ids.get(t.entity_id)?.kind]!==t.module)fail();
    tids.add(t.id);
  }
  const rids=new Set();
  for(const r of store.reviews){
    if(!r||!idOK(r.id)||rids.has(r.id)||ids.get(r.entity_id)?.kind!=='mistake'||!['independent','hint','incorrect'].includes(r.result)||!textOK(r.note)||!textOK(r.reviewed)||!dateOK(r.next_review))fail();
    rids.add(r.id);
  }
  return {schema:1,entities:store.entities,tasks:store.tasks,reviews:store.reviews};
}
function newId(){return crypto.randomUUID().replaceAll('-','');}
async function api(path,options={}){
  const store=readStore(),method=options.method||'GET',body=options.body;
  if(path==='/state')return {...structuredClone(store),entities:[...store.entities].sort((a,b)=>b.updated.localeCompare(a.updated)),tasks:[...store.tasks].reverse(),reviews:[...store.reviews].reverse(),documents:[],jobs:[],backups:[],csrf:'browser-only',version:'HTML 1.0'};
  const now=new Date().toISOString();let result;
  if(path==='/entities'&&method==='POST'){
    result={...body,id:newId(),created:now,updated:now};store.entities.push(result);
  }else if(/^\/entities\/[a-f0-9]{32}$/.test(path)&&method==='PUT'){
    const e=store.entities.find(e=>e.id===path.split('/')[2]);if(!e)throw new Error('记录不存在');if(e.kind!==body.kind)throw new Error('不能更改记录类型');Object.assign(e,body,{updated:now});result=e;
  }else if(path==='/tasks'&&method==='POST'){
    result={...body,id:newId(),created:now,completed:body.status==='done'?now:null};store.tasks.push(result);
  }else if(/^\/tasks\/[a-f0-9]{32}$/.test(path)&&method==='PUT'){
    const t=store.tasks.find(t=>t.id===path.split('/')[2]);if(!t)throw new Error('任务不存在');Object.assign(t,body,{completed:body.status==='done'?(t.completed||now):null});result=t;
  }else if(/^\/entities\/[a-f0-9]{32}\/reviews$/.test(path)&&method==='POST'){
    const e=store.entities.find(e=>e.id===path.split('/')[2]);if(e?.kind!=='mistake')throw new Error('只有错题可以记录再练');result={...body,id:newId(),entity_id:e.id,reviewed:now};store.reviews.push(result);e.details.next_review=body.next_review;e.updated=now;
  }else throw new Error('单文件 HTML 版不提供此项后端功能。');
  saveStore(store);return structuredClone(result);
}

async function reload(){state=await api('/state');render();}
let toastTimer;
