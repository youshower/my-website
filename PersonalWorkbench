    if(file.size>5*1024*1024)throw new Error('备份超过 5 MB，不能在这个轻量版本中导入。');
    pendingImport=validateStore(JSON.parse(await file.text()));
    openDialog('恢复浏览器记录',`<form id="import-form"><div class="dialog-body"><p class="subtitle">将恢复 ${pendingImport.entities.length} 条记录、${pendingImport.tasks.length} 项任务和 ${pendingImport.reviews.length} 次再练。此操作会替换当前记录。</p><div class="info-note">先下载并保留当前记录，确认文件已保存后再继续。如果取消，原有数据不会变化。</div><button type="button" class="button" data-action="download-before-import">先下载当前记录</button><label class="check-field"><input type="checkbox" id="import-check" disabled required>我已确认当前记录的备份文件下载成功</label>${field('confirmation','请输入“恢复记录”','','text',{required:true})}<div class="form-error" id="import-error" role="alert"></div></div><div class="dialog-actions"><button type="button" class="button" data-action="close">取消</button><button type="submit" class="button primary">恢复记录</button></div></form>`);
  }catch(error){toast(error.message);pendingImport=null;}
});
document.addEventListener('submit',async event=>{
  if(event.target.id!=='import-form')return;event.preventDefault();
  try{
    if(!pendingImport||!$('#import-check').checked||new FormData(event.target).get('confirmation')!=='恢复记录')throw new Error('请下载备份、勾选确认，并准确输入“恢复记录”。');
    saveStore(pendingImport);pendingImport=null;$('#dialog').close();selected=null;await reload();location.hash='#settings';toast('记录已恢复。');
  }catch(error){$('#import-error').textContent=error.message;}
});

api('/state').then(result=>{state=result;route();}).catch(error=>{$('#main').innerHTML=`<div class="error-box"><h2>暂时无法打开浏览器存储</h2><p>${esc(error.message)}</p><p>请使用普通浏览模式，允许此页面存储数据，再刷新重试。</p></div>`;});

</script>
</body>
</html>
