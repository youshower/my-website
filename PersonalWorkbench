    ${view==='education'?'<div class="info-note">这是家长与孩子共同复盘的空间。不同考试的分数不直接代表能力变化；优先听孩子自己的分析。</div>':''}
    ${records.length?`<div class="entity-grid">${records.map(entityCard).join('')}</div>`:`<section class="panel">${empty(search?'没有匹配的记录':`还没有${names[kind]}`,search?'试试其他关键词或状态。':{project:'先记录一个正在推进的项目，写清目标和最近的节点。',learning:'一篇文献、一个技能，或者一个想弄懂的问题。',exam:'从最近一次考试开始，先记录做得好的地方。',mistake:'只选值得再练的代表题，可以先上传图片，稍后补充分析。'}[kind],actionButton('new-entity',`＋ 添加${names[kind]}`,`data-kind="${kind}"`,'small'),modules[kind])}</section>`}`;
}
function entityCard(e){
  const d=e.details,tasks=state.tasks.filter(t=>t.entity_id===e.id),done=tasks.filter(t=>t.status==='done').length;
