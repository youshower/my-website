function renderOverview(){
  const pending=state.tasks.filter(t=>visibleTask(t)&&t.status!=='done');
  const overdue=pending.filter(t=>t.due&&t.due<today());
  const dueToday=pending.filter(t=>t.due===today());
  const thisWeek=pending.filter(t=>t.due&&t.due>=today()&&t.due<=afterDays(7));
  const reviewCount=state.tasks.filter(t=>visibleTask(t)&&t.status==='done').length;
  const focus=[...pending].filter(matches).sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999')||(a.priority==='high'?-1:1)).slice(0,6);
  const recent=state.entities.filter(e=>visibleEntity(e)&&matches(e)&&e.status!=='archived').slice(0,4);
  const courses=state.entities.filter(e=>e.status==='active');
  return heading('A LITTLE PROGRESS, EVERY DAY','今天，从一件重要的事开始。','把科研、学习与孩子的成长，放在一个安静的空间里。',`<div class="date-badge">${new Date().toLocaleDateString('zh-CN',{month:'long',day:'numeric',weekday:'long'})}</div>`)+`
  <div class="overview-grid"><section class="hero"><div class="eyebrow">留一点时间，给长期重要的事</div><h2>有所思，也有所行。</h2><p>${pending.length?`还有 ${pending.length} 项待推进的任务。选一个小步骤，给今天留下进展。`:'从一个项目、一条笔记，或一次共同复盘开始。记录保存在当前浏览器。'}</p>${actionButton('new-task','＋ 记下下一步')}</section><section class="metric-card"><div class="section-heading"><h2>近期节奏</h2>${icon('clock')}</div><div class="metrics"><div><div class="metric-value">${dueToday.length}</div><div class="metric-label">今日到期</div></div><div><div class="metric-value ${overdue.length?'alert':''}">${overdue.length}</div><div class="metric-label">已逾期</div></div><div><div class="metric-value">${thisWeek.length}</div><div class="metric-label">未来 7 天</div></div><div><div class="metric-value">${reviewCount}</div><div class="metric-label">累计完成任务</div></div></div></section></div>
  <div class="module-grid"><a class="module-card" href="#research"><div class="module-icon">${icon('research')}</div><div class="module-head"><h3>科研 · 逐步推进</h3><span>↗</span></div><p>从下一节点，到可查证的成果。</p><div class="module-stat"><strong>${courses.filter(e=>e.kind==='project').length}</strong> 个进行中的项目</div></a><a class="module-card" href="#learning"><div class="module-icon gold">${icon('learning')}</div><div class="module-head"><h3>学习 · 有所积累</h3><span>↗</span></div><p>留下问题、理解与可以实践的下一步。</p><div class="module-stat"><strong>${courses.filter(e=>e.kind==='learning').length}</strong> 个正在学习的主题</div></a>${!hideFamily?`<a class="module-card" href="#education"><div class="module-icon blue">${icon('education')}</div><div class="module-head"><h3>成长 · 一起复盘</h3><span>↗</span></div><p>看见进步，也找到下一次练习的重点。</p><div class="module-stat"><strong>${courses.filter(e=>e.kind==='mistake'&&e.details.next_review&&e.details.next_review<=today()).length}</strong> 道到期再练的错题</div></a>`:''}</div>
  <div class="lower-grid"><section class="panel"><div class="section-heading"><h2>接下来，做这些</h2><a class="button subtle" href="#tasks">查看全部 →</a></div>${focus.length?focus.map(taskRow).join(''):empty(search?'没有找到匹配的任务':'给今天留一个小目标',search?'换个关键词试试。':'任务只需填写标题，其他信息可以慢慢补。',actionButton('new-task','＋ 添加任务','','small'))}</section><section class="panel"><div class="section-heading"><h2>最近在关注</h2><span class="muted">持续积累</span></div>${recent.length?recent.map(e=>`<a class="recent-item" href="#${modules[e.kind]}/${e.id}"><span class="mini-icon">${icon(modules[e.kind])}</span><div><h3>${esc(e.title)}</h3><p>${names[e.kind]} · ${formatTime(e.updated)}</p></div></a>`).join(''):empty('这里会留下您的进展','新建的项目、学习笔记和复盘会显示在这里。','','learning')}</section></div>`;
}
function taskRow(t){return `<div class="task-row ${t.status==='done'?'completed':''}"><button class="task-check ${t.status==='done'?'done':''}" data-action="toggle-task" data-id="${t.id}" aria-label="${t.status==='done'?'重新打开':'完成'}任务：${esc(t.title)}">${t.status==='done'?'✓':''}</button><div class="task-body"><button class="task-title" data-action="edit-task" data-id="${t.id}">${esc(t.title)}</button><div class="task-meta">${moduleTag(t.module)}${t.milestone?'<span>◆ 里程碑</span>':''}${t.priority==='high'?'<span class="overdue">优先</span>':''}${t.entity_id?`<a href="#${t.module}/${t.entity_id}">${esc(entityById(t.entity_id)?.title||'')}</a>`:''}${t.status==='doing'?'<span>进行中</span>':''}</div></div><span class="task-date ${t.due&&t.due<today()&&t.status!=='done'?'overdue':''}">${t.due?esc(t.due===today()?'今天':t.due):'未设日期'}</span></div>`;}
function renderTasks(){
